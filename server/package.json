{
  "name": "project-management-api",
  "version": "1.0.0",
  "type": "module",
  "description": "A RESTful Project Management API built with Node.js, Express, MongoDB, and Mongoose, designed to practice professional backend development concepts including authentication, authorization, project and task management, validation, security, and scalable API architecture.",
  "main": "server.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:watch": "node --test --watch --test-concurrency=1 \"tests/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 \"tests/*.test.js\"",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Engr-Ifex/project-management-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Engr-Ifex/project-management-api/issues"
  },
  "homepage": "https://github.com/Engr-Ifex/project-management-api#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}

PORT=5000
NODE_ENV=development
BCRYPT_SALT_ROUNDS=10

# Must be at least 32 characters. The application refuses to start in
# production with a shorter secret. Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
COOKIE_MAX_AGE=900000

MONGODB_URI=your_mongodb_connection_string

# Comma-separated list of browser origins allowed to call the API with
# credentials, e.g. https://app.example.com,https://staging.example.com
# Leave empty in development to allow any origin (without credentials).
# In production an empty value refuses all cross-origin browser requests.
CORS_ORIGINS=

# Number of trusted reverse-proxy hops in front of the app. Leave at 0 when the
# app is directly exposed. Required for rate limiting to see real client IPs.
TRUST_PROXY=0

# Broad API rate limit: requests per IP per window.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

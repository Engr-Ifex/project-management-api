# =============================================================================
# Environment configuration
#
# Copy to `.env` for local development:   cp .env.example .env
#
# `.env` is gitignored. Never commit a real value — in particular never commit
# a JWT secret or a database URI containing credentials.
#
# In production, prefer setting these in the platform's secret manager rather
# than shipping a file. Run `npm run preflight` to check a production
# environment before starting.
# =============================================================================

# development | test | production
NODE_ENV=development
PORT=5000

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Must be at least 32 characters. The application REFUSES TO START in
# production with a shorter secret, or with one of the placeholder values.
# Generate one with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_at_least_32_characters

JWT_ACCESS_EXPIRES_IN=15m

# Session cookie lifetime, in milliseconds. Keep in step with the token
# lifetime above, or the cookie will outlive the token it carries.
COOKIE_MAX_AGE=900000

# bcrypt cost factor. 10-15; outside that range the app refuses to start.
# Higher is slower to hash and slower to brute-force.
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local:        mongodb://127.0.0.1:27017/project_management
# Atlas:        mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string

# How long the driver searches for a reachable server before failing.
# Lowered from the 30s default so a misconfigured host fails fast.
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API WITH credentials,
# e.g. https://app.example.com,https://staging.example.com
#
# Leave empty in development to allow any origin (without credentials).
# In production an empty value refuses ALL cross-origin browser requests, so a
# browser client will not work. `*` is rejected by the preflight — a wildcard
# cannot be combined with credentialed requests.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Proxy
# -----------------------------------------------------------------------------
# Number of trusted reverse-proxy hops in front of the app. Leave at 0 when the
# app is directly exposed.
#
# Set this correctly or rate limiting is broken: `req.ip` will be the proxy's
# address, so every client shares one budget and one abusive client locks
# everyone out. 1 for a single nginx/ALB in front.
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Broad API limit: requests per IP per window. Authentication endpoints have a
# separate, stricter limit (10 per 15 minutes) that is not configurable here.
#
# Counters live in process memory, so with N instances the effective limit is
# N x RATE_LIMIT_MAX. See docs/DEPLOYMENT.md — Known limitations.
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# error | warn | info | http | debug
# Defaults to `info` in production and `debug` elsewhere. Production output is
# one JSON object per line; other environments are human-readable.
LOG_LEVEL=debug

# How long to wait for in-flight requests and the database to close during
# shutdown before exiting anyway. MUST be lower than the orchestrator's own
# grace period (Docker's `stop_grace_period`, Kubernetes'
# `terminationGracePeriodSeconds`), or the platform SIGKILLs first and the
# graceful path never runs.
SHUTDOWN_TIMEOUT_MS=10000

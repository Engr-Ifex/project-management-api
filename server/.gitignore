# ===================================
# Dependencies
# ===================================
node_modules/

# ===================================
# Environment Variables
# ===================================
# Never commit a real environment file. `.env.example` documents the shape.
.env
.env.*
!.env.example

# ===================================
# Logs
# ===================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===================================
# Coverage
# ===================================
coverage/
.nyc_output/

# ===================================
# Build Output
# ===================================
dist/
build/

# ===================================
# Operating System Files
# ===================================
.DS_Store
Thumbs.db

# ===================================
# Temporary Files
# ===================================
*.tmp
*.temp

# ===================================
# IDE Files
# ===================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/

# ===================================
# Miscellaneous
# ===================================
*.pid
*.seed

# ===================================
# Uploaded Files (runtime user data)
# ===================================
# Both stores hold data created at runtime by users, never source. They are
# mounted as a volume in production, so committing them would ship one
# deployment's files into the next.
#
# The directories themselves are kept via .gitkeep so a fresh clone has the
# structure the app expects.
src/uploads/attachments/*
!src/uploads/attachments/.gitkeep

src/uploads/avatars/*
!src/uploads/avatars/.gitkeep

# Legacy top-level upload directory, superseded by src/uploads.
# Anchored with a leading slash: an unanchored `uploads/` would also match
# `src/uploads/`, ignoring the .gitkeep files above.
/uploads/
